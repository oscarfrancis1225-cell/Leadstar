{
  "name": "leadstar-financial",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 2000",
    "build": "next build",
    "start": "next start -p 2000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:research": "node --env-file=.env.local --import tsx scripts/content/research-topic.ts",
    "content:brief": "node --env-file=.env.local --import tsx scripts/content/create-brief.ts",
    "content:draft": "node --env-file=.env.local --import tsx scripts/content/draft-article.ts",
    "content:review": "node --env-file=.env.local --import tsx scripts/content/review-article.ts",
    "content:image": "node --env-file=.env.local --import tsx scripts/content/generate-image.ts",
    "content:validate": "node --import tsx scripts/content/validate-content.ts"
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "openai": "^7.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
